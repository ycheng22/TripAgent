DEFAULT_AI_PROVIDER=gemini
DEFAULT_AI_MODEL=gemini-3.5-flash-lite
LIVE_RATE_LIMIT_MAX_CALLS=5
LIVE_RATE_LIMIT_WINDOW_SECONDS=600
